<Project>
  <!--
    One source, two builds. JellyfinTarget picks the Jellyfin it is built for:
      10.11  .NET 9,  Jellyfin.Controller and Jellyfin.Model 10.11.0
      12     .NET 10, Jellyfin.Controller and Jellyfin.Model 12.0.0
    Build with -p:JellyfinTarget=10.11 or -p:JellyfinTarget=12 (the default). Each has its own obj and bin folders, so
    the two never mix. Version numbers are in SYNC.md: an even third number is the 10.11 build, an odd one the 12 build.
  -->
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">12</JellyfinTarget>
    <BaseIntermediateOutputPath>obj/jellyfin-$(JellyfinTarget)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/jellyfin-$(JellyfinTarget)/</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == '10.11'">
    <PluginFramework>net9.0</PluginFramework>
    <JellyfinPackageVersion>10.11.0</JellyfinPackageVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_10_11</DefineConstants>
    <Version>1.0.2.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == '12'">
    <PluginFramework>net10.0</PluginFramework>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_12</DefineConstants>
    <Version>1.0.3.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Authors>TheMightyTRexUK</Authors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="CheckJellyfinTarget" BeforeTargets="Restore;CollectPackageReferences;Build">
    <Error Condition="'$(PluginFramework)' == ''" Text="JellyfinTarget must be 10.11 or 12, not '$(JellyfinTarget)'." />
  </Target>
</Project>
