<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Only the tests need Skia's native library: inside Jellyfin it is already there. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.PictureShrinker\Jellyfin.Plugin.PictureShrinker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\pictures\**\*" LinkBase="pictures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules.json" Link="rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
